From ea25a484d4259a1265faec3f20421802fef99351 Mon Sep 17 00:00:00 2001
From: Anton Palgunov <toxblh@gmail.com>
Date: Wed, 25 Nov 2026 11:38:09 +0400
Subject: [PATCH 3/3] e2k: 512 KB stack for the ShutdownDetector thread

PTHREAD_STACK_MIN * 2 (32 KB) overflows on e2k already in PartitionAlloc's
thread cache setup when the thread starts (SIGSEGV at startup).
---
 shell/browser/electron_browser_main_parts_posix.cc | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/shell/browser/electron_browser_main_parts_posix.cc b/shell/browser/electron_browser_main_parts_posix.cc
index 802da2a..2a2094f 100644
--- a/shell/browser/electron_browser_main_parts_posix.cc
+++ b/shell/browser/electron_browser_main_parts_posix.cc
@@ -189,7 +189,11 @@ void ElectronBrowserMainParts::InstallShutdownSignalHandlers(
   g_pipe_pid = getpid();
   g_shutdown_pipe_read_fd = pipefd[0];
   g_shutdown_pipe_write_fd = pipefd[1];
-#if !defined(ADDRESS_SANITIZER)
+#if defined(__e2k__)
+  // e2k: C frames are much larger than on x86 (the 32 KB of PTHREAD_STACK_MIN * 2 overflow already in
+  // PartitionAlloc's thread-cache setup when the thread starts)
+  const size_t kShutdownDetectorThreadStackSize = 512 * 1024;
+#elif !defined(ADDRESS_SANITIZER)
   const size_t kShutdownDetectorThreadStackSize = PTHREAD_STACK_MIN * 2;
 #else
   // ASan instrumentation bloats the stack frames, so we need to increase the
-- 
